	(text "HV divider scales HV+ \n(100V-130V)down to V_IN_1 \n(max 3.17V) for \nisolated amplifier"
		(exclude_from_sim no)
		(at 14.605 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3dc6ef71-86bc-457a-8af5-cc262cfe6c74")
	)
	(text "line with line tool and \"e\""
		(exclude_from_sim no)
		(at 109.855 60.325 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7c6b5301-702a-45b0-8539-7079a005f5c5")
	)
	(text "AMC1350 isolated amplifier measures V_IN_1 on the HV side and outputs differential V1+/V1- (gain 0.4) on the \nLV side"
		(exclude_from_sim no)
		(at 50.8 17.145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7f140f6d-61f9-4e40-a93b-8825933cc58b")
	)
	(text "Vin = HV x Rbot / (Rtop + Rbot)\nRtop = 4 x 100k = 400k\nRbot = 10k\n\nVin = HV x 10k / (400k + 10k) = HV x 0.02439\n\nHV = 100V -> Vin = 2.44V\nHV = 120V -> Vin = 2.93V\nHV = 130V -> Vin = 3.17V\n\nAmp linear input range: +/-5V (AMC1350)\nDivider current at 130V: 130V / 410k = 0.32mA\nPer top resistor: ~32V, ~10mW\nAmp input (1.25M) loads Rbot ~0.8%: correct in firmware"
		(exclude_from_sim no)
		(at 49.53 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a0c1bc99-1af6-4e49-a294-83c6294219e1")
	)
	(text "V+ and V- not descriptive bruh"
		(exclude_from_sim no)
		(at 123.825 28.575 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "aee7f6bb-ae41-4e9e-a739-6bf35dd45d95")
	)
	(text "change HVGND and LVGND global labels into just a hierarchal pin"
		(exclude_from_sim no)
		(at 198.12 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bb8457c3-849f-4fd4-beb2-720f4775fc08")
	)
	(text "V_IN_1 to V_IN_BAT to be more descriptive"
