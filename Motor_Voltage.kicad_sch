	(text "Vin = HV x Rbot / (Rtop + Rbot)\nRtop = 4 x 100k = 400k\nRbot = 10k\n\nVin = HV x 10k / (400k + 10k) = HV x 0.02439\n\nHV = 100V -> Vin = 2.44V\nHV = 120V -> Vin = 2.93V\nHV = 130V -> Vin = 3.17V\n\nAmp linear input range: +/-5V (AMC1350)\nDivider current at 130V: 130V / 410k = 0.32mA\nPer top resistor: ~32V, ~10mW\nAmp input (1.25M) loads Rbot ~0.8%: correct in firmware"
		(exclude_from_sim no)
		(at 46.355 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1f0dd064-ee20-4a4d-a63d-3936fa1369ef")
	)
	(text "AMC1350 isolated amplifier measures V_IN_1 on the HV side and outputs differential V1+/V1- (gain 0.4) on the \nLV side"
		(exclude_from_sim no)
		(at 46.99 17.145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "50a492e8-b658-4bdf-9e04-535dd4928eb8")
	)
	(text "HV divider scales HV+ \n(100V-130V)down to V_IN_1 \n(max 3.17V) for \nisolated amplifier"
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5c3bf11e-df63-4099-9ba4-03b81246a943")
	)
	(text "Op-amp difference stage : MOT_V+ minus MOT_V−, filtered \nsmooth V_OUT_MOT before the ADC"
		(exclude_from_sim no)
		(at 163.195 17.145 0)
		(effects
