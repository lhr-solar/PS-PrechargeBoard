	(text "hierarchal pin works like label"
		(exclude_from_sim no)
		(at 80.645 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "138b885c-c26a-44f9-afbb-5a0139847c79")
	)
	(text "Vin = HV x Rbot / (Rtop + Rbot)\nRtop = 4 x 100k = 400k\nRbot = 10k\n\nVin = HV x 10k / (400k + 10k) = HV x 0.02439\n\nHV = 100V -> Vin = 2.44V\nHV = 120V -> Vin = 2.93V\nHV = 130V -> Vin = 3.17V\n\nAmp linear input range: +/-5V (AMC1350)\nDivider current at 130V: 130V / 410k = 0.32mA\nPer top resistor: ~32V, ~10mW\nAmp input (1.25M) loads Rbot ~0.8%: correct in firmware"
		(exclude_from_sim no)
		(at 49.53 73.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3e8b09fd-3ad3-4713-8464-e660371e913d")
	)
	(text "AMC1350 isolated amplifier measures V_IN_1 on the HV side and outputs differential V1+/V1- (gain 0.4) on the \nLV side"
		(exclude_from_sim no)
		(at 50.8 17.145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "437bf422-ba18-40a0-a130-c7c5f34f83e9")
	)
	(text "V_IN_2 to V_IN_MOT to be more descriptive"
		(exclude_from_sim no)
		(at 35.56 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6315dc75-cb94-4919-bf27-7e8b2e6cf910")
	)
	(text "V_IN_2 change to output"
		(exclude_from_sim no)
		(at 35.56 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6b87a89b-0d09-4c51-8261-b37d1e7aeecc")
	)
	(text "V+ and V- not descriptive bruh"
		(exclude_from_sim no)
		(at 125.095 28.575 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ed4c008-f085-41d8-969b-3ee016056f14")
	)
	(text "HV divider scales HV+ \n(100V-130V)down to V_IN_2 \n(max 3.17V) for \nisolated amplifier"
		(exclude_from_sim no)
		(at 14.605 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8fde4123-cf87-494d-b070-fa79225a451f")
	)
	(text "change HVGND and LVGND global labels into just a hierarchal pin"
		(exclude_from_sim no)
		(at 197.485 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a0f13519-adb6-4a8b-b630-faf650e039e3")
	)
